      H       -1.8449999992       -1.7738900018       -2.1869699976
      H       -0.7407599975       -2.7608199991       -0.1691000012
      H       -2.4738500024        0.4561700018        2.1362199980
      C       -3.7557999989        1.6530600006        0.0035800002
      H       -3.6802300007        2.2098699985        0.9463299977
      H       -3.4695600022        2.3099300005       -0.8288399990
      H       -4.8109599997        1.3798199987       -0.1521099995
