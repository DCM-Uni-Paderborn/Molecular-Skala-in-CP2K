&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME 72b5337a01fda041321db7026d180a3f3e97d39b
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    MULTIPLICITY 1
    UKS FALSE
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1e-10
    &END QS
    &SCF
      EPS_SCF 1e-05
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
        NMIXING 2
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL aug-s0-funv2-cpu.fun
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MO
        ENERGIES T
        OCCNUMS  T
        &EACH
          QS_SCF 0
        &END
      &END
    &END
  &END DFT
  &SUBSYS
    &CELL
      ABC 30.0000 35.0000 36.0000
      ALPHA_BETA_GAMMA 90.0000 90.0000 90.0000
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &COORD
      Br        0.0000000000        0.0000000000        1.7941500011
      C         0.0000000000        0.0000000000       -0.0976500020
      C         0.0000000000        1.2071000021       -0.7758000010
