      C         0.0000000000       -1.1996599981       -2.1630199979
      C         0.0000000000       -1.2071000021       -0.7758000010
      H         0.0000000000        2.1390299978       -0.2275699977
      H         0.0000000000        2.1395000024       -2.6999799978
      H         0.0000000000        0.0000000000       -3.9401599997
      H         0.0000000000       -2.1395000024       -2.6999799978
      H         0.0000000000       -2.1390299978       -0.2275699977
    &END COORD
    &KIND Br
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q7
      POTENTIAL GTH-SCAN-q7
    &END KIND
    &KIND C
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q4
      POTENTIAL GTH-SCAN-q4
    &END KIND
    &KIND H
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q1
