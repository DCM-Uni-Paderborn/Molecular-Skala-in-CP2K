&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME f1adf6178a9f4598a711045555ede9b92ad6fc80
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    MULTIPLICITY 1
    UKS FALSE
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1e-10
    &END QS
    &SCF
      EPS_SCF 1e-05
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
        NMIXING 2
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL aug-s0-funv2-cpu.fun
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MO
        ENERGIES T
        OCCNUMS  T
        &EACH
          QS_SCF 0
        &END
      &END
    &END
  &END DFT
  &SUBSYS
    &CELL
      ABC 32.0000 33.0000 33.0000
      ALPHA_BETA_GAMMA 90.0000 90.0000 90.0000
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &COORD
      O       -0.6015600010       -1.6259000014        0.0000000000
      O        0.0716100011       -1.0609400024        1.0901000003
      O        0.0716100011       -1.0609400024       -1.0901000003
      C        0.0716100011        0.3180499978        0.7706399993
      C        0.0716100011        0.3180499978       -0.7706399993
      H       -0.8151899999        0.8154299976        1.1676600012
      H       -0.8151899999        0.8154299976       -1.1676600012
      H        0.9727600022        0.7404099997        1.2093900006
      H        0.9727600022        0.7404099997       -1.2093900006
    &END COORD
    &KIND C
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q4
      POTENTIAL GTH-SCAN-q4
    &END KIND
    &KIND H
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q1
      POTENTIAL GTH-SCAN-q1
    &END KIND
    &KIND O
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q6
      POTENTIAL GTH-SCAN-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

