&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME e36a8c19b3b46e20ed0aa0ce55ea232d3effff75
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    MULTIPLICITY 1
    UKS FALSE
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1e-10
    &END QS
    &SCF
      EPS_SCF 1e-05
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
        NMIXING 2
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL aug-s0-funv2-cpu.fun
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MO
        ENERGIES T
        OCCNUMS  T
        &EACH
          QS_SCF 0
        &END
      &END
    &END
  &END DFT
  &SUBSYS
    &CELL
      ABC 36.0000 34.0000 34.0000
      ALPHA_BETA_GAMMA 90.0000 90.0000 90.0000
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &COORD
      O       -1.3240500019        0.9646900021        0.8821200001
      P       -1.5540400011       -0.1534000012       -0.2798400006
      O       -2.6923800023        0.0791199994       -1.1640299990
      O       -0.0872800020        0.0066799997       -0.9854699974
      P        1.2812299980       -0.2202299976       -0.1443500020
      O        1.1622299975       -1.3533199999        0.7948300020
      O        2.4048899990       -0.4135399990       -1.2351000013
      O        1.6145800012        1.2180200025        0.4565700015
      O       -1.5036799998       -1.5634799986        0.4258700026
      H       -2.1611000001        1.2397700008        1.2916200010
      H        2.5795500016        0.3778100013       -1.7730599979
      H        0.8584400026        1.5632999990        0.9709700021
      H       -0.5783899980       -1.7454100018        0.7598699995
    &END COORD
    &KIND H
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q1
      POTENTIAL GTH-SCAN-q1
    &END KIND
    &KIND O
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q6
      POTENTIAL GTH-SCAN-q6
    &END KIND
    &KIND P
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q5
      POTENTIAL GTH-SCAN-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

