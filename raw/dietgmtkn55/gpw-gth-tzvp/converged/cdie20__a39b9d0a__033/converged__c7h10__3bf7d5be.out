      H       -1.1893400000        0.2957000025        1.4082299991
      C       -2.6610100015        0.1522600001       -0.0599499994
      H       -3.4516799986        0.5360699978        0.5704100004
      H       -2.9312500025       -0.1208600003       -1.0730399991
      H        0.4230800004       -2.5248699987        0.6178199974
      H        2.7568900011       -0.9384799978        0.4558000011
      C        1.0513499989        1.7315300011        0.1920400026
      H        2.0444200024        2.1808099991        0.1343999993
