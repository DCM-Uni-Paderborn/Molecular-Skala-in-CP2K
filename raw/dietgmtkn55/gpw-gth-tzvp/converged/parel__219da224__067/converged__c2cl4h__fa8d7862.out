&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME fa8d7862859673d50baebca5ed2ed6b199ee4452
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 1
    MULTIPLICITY 1
    UKS FALSE
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1e-10
    &END QS
    &SCF
      EPS_SCF 1e-05
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
        NMIXING 2
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL aug-s0-funv2-cpu.fun
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MO
        ENERGIES T
        OCCNUMS  T
        &EACH
          QS_SCF 0
        &END
      &END
    &END
  &END DFT
  &SUBSYS
    &CELL
      ABC 33.0000 34.0000 32.0000
      ALPHA_BETA_GAMMA 90.0000 90.0000 90.0000
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &COORD
      C         0.0000000000       -0.7086500006        0.0996500008
      C         0.0000000000        0.7086500006        0.0996500008
      Cl       -1.4459099989       -1.5704300004        0.2108599996
      Cl        1.4459099989       -1.5704300004        0.2108599996
      Cl       -1.4459099989        1.5704300004        0.2108599996
      Cl        1.4459099989        1.5704300004        0.2108599996
      H         0.0000000000        0.0000000000       -1.0427400000
    &END COORD
    &KIND C
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q4
      POTENTIAL GTH-SCAN-q4
    &END KIND
    &KIND Cl
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q7
      POTENTIAL GTH-SCAN-q7
    &END KIND
    &KIND H
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q1
      POTENTIAL GTH-SCAN-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

