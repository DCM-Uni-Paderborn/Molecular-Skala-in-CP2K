&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME a731dd57852baad2631c6e72c617713d7adf888c
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    MULTIPLICITY 2
    UKS TRUE
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1e-10
    &END QS
    &SCF
      EPS_SCF 1e-05
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.4
        NMIXING 2
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL aug-s0-funv2-cpu.fun
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MO
        ENERGIES T
        OCCNUMS  T
        &EACH
          QS_SCF 0
        &END
      &END
    &END
  &END DFT
  &SUBSYS
    &CELL
      ABC 32.0000 33.0000 32.0000
      ALPHA_BETA_GAMMA 90.0000 90.0000 90.0000
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &COORD
      C       -0.0256800016       -0.6249099984        0.0000000000
      C       -0.0256800016        0.8661300005        0.0000000000
      H        0.9939799978       -1.0287399977        0.0000000000
      H       -0.5237299980       -1.0245300014        0.8834199980
      H       -0.5237299980       -1.0245300014       -0.8834199980
      H        0.0524199981        1.4182900019       -0.9243199988
      H        0.0524199981        1.4182900019        0.9243199988
    &END COORD
    &KIND C
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q4
      POTENTIAL GTH-SCAN-q4
    &END KIND
    &KIND H
      BASIS_SET TZVP-MOLOPT-SCAN-GTH-q1
      POTENTIAL GTH-SCAN-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

