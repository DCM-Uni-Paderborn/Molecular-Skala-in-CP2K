      H        2.1236599981       -0.4364100008       -0.9277599999
      H       -0.0055099995        0.2494000023       -2.1676500022
      H       -1.3573699995        0.9700500011       -1.2864000012
      H        0.2236500011        1.7645000009       -1.2864300002
      H       -1.7192300018       -1.1887200001        0.0000000000
      H       -0.3835299995       -1.9437100014       -0.8837800026
