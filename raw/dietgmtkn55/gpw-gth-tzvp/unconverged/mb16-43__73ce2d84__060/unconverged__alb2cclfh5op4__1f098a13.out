      P         0.0323200009       -2.0239300015       -1.1765400023
      O         0.2178500019        0.3074800005        2.9467499999
      Cl        2.3356000007        2.0771000025        1.3650699989
      Al        0.7075500000        0.7418800011        1.0452799977
      P         1.6316799977        0.9129400005       -2.3424899991
      B        -1.5999499977        0.0234900018       -0.1462400007
      H         0.5900799989       -0.5165699976        3.3098100014
      F         0.3277699989        1.1531000025       -3.2876699995
      P        -1.4154999997        1.5884599993        0.5558400002
      H        -2.1864599977       -1.2394699996       -1.8222499989
      P         1.5081900026       -1.4017100014        0.3757700020
