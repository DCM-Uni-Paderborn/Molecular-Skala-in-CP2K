&GLOBAL
  PRINT_LEVEL LOW
  PROJECT HCl_ECP_GPWTYPE_gauxc_pbe
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME /home/kuehne88/work/cp2k-gauxc-paper-current/tests/QS/regtest-ecp/ECP_BASIS_POT
    UKS FALSE
    MULTIPLICITY 1
    &MGRID
      CUTOFF 600
      NGRIDS 5
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-14
      EXTRAPOLATION USE_PREV_P
      METHOD GAPW
      GAPW_ACCURATE_XCINT T
      EPSFIT 1.0E-4
      EPSISO 1.0E-12
      EPSRHO0 1.0E-6
      EPS_GVG 1.0E-6
      EPS_PGF_ORB 1.0E-6
      EPSSVD 0.0
      LMAXN0 4
      GAPW_1C_BASIS EXT_SMALL
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL PBE
          GRID FINE
          PRUNING_SCHEME ROBUST
          PSEUDOPOTENTIAL_GAPW_REPRESENTATION DIRECT_VALENCE
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.00000000 6.00000000 6.00000000
      PERIODIC NONE
    &END CELL
    &COORD
      Cl     0.00000000     0.00000000     0.00006500
      H      0.00000000     0.00000000     1.29993500
    &END COORD
    &KIND Cl
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL ECP ccECP
      GPW_TYPE
    &END KIND
    &KIND H
      BASIS_SET DZV-GTH-PADE
      POTENTIAL ECP ccECP
      GPW_TYPE
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
