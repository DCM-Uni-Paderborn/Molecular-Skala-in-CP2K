&GLOBAL
  PRINT_LEVEL LOW
  PROJECT skala_h2o_4_cpu_host
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    UKS FALSE
    &MGRID
      CUTOFF 150
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-8
      EXTRAPOLATION USE_PREV_P
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.0E-4
      MAX_SCF 1
      IGNORE_CONVERGENCE_FAILURE T
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL /home/kuehne88/skala-cpu.fun
          GRID FINE
          PRUNING_SCHEME ROBUST
          BATCH_SIZE 512
          LB_EXECUTION_SPACE HOST
          INT_EXECUTION_SPACE HOST
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.71390000 10.71390000 10.71390000
      PERIODIC NONE
    &END CELL
    &COORD
      O      3.00000000     3.75695000     3.00000000
      H      3.00000000     4.51390000     3.58588000
      H      3.00000000     3.00000000     3.58588000
      O      3.00000000     3.75695000     6.20000000
      H      3.00000000     3.00000000     6.78588000
      H      3.00000000     4.51390000     6.78588000
      O      3.00000000     6.95695000     3.00000000
      H      3.00000000     6.20000000     3.58588000
      H      3.00000000     7.71390000     3.58588000
      O      3.00000000     6.95695000     6.20000000
      H      3.00000000     7.71390000     6.78588000
      H      3.00000000     6.20000000     6.78588000
    &END COORD
    &KIND H
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
