&GLOBAL
  PRINT_LEVEL LOW
  PROJECT H2O_GAPW_AE_skala
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    UKS FALSE
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION USE_PREV_P
      METHOD GAPW
      GAPW_ACCURATE_XCINT T
      QUADRATURE GC_LOG
      LMAXN0 6
      LMAXN1 6
      EPSISO 1.0E-12
      EPSRHO0 1.0E-8
      EPSFIT 1.0E-5
      ALPHA0_H 10.0
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          MODEL SKALA
          GRID FINE
          PRUNING_SCHEME ROBUST
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC NONE
    &END CELL
    &COORD
      O      6.00000000     6.00000000     6.00000000
      H      6.00000000     6.75595000     6.58588000
      H      6.00000000     5.24305000     6.58588000
    &END COORD
    &KIND O
      BASIS_SET QZVPP-MOLOPT-PBE-ae
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET QZVPP-MOLOPT-PBE-ae
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
